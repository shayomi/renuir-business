# Waitlist / lead capture (app/api/lead)
# Airtable — leads are written to the "Waitlist" table (field: Email)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# Resend — sends the team notification + user confirmation emails
RESEND_API_KEY=

# Optional: forward raw leads to an external collector (Zapier/Make/etc.).
# If unset, leads go to Airtable + Resend above.
LEAD_WEBHOOK_URL=
